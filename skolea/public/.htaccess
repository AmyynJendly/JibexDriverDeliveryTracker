<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laisse passer les fichiers et dossiers reels (assets, uploads, ...)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Toutes les autres requetes passent par le controleur frontal
    RewriteRule ^ index.php [QSA,L]
</IfModule>

Options -Indexes
